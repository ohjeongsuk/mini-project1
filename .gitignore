# 하위 독립 저장소 (폴리레포) — 부모가 gitlink로 커밋하지 않도록 반드시 제외
minipj1-backend/
minipj1-frontend/

# 비밀·환경 변수
# 이 저장소는 문서만 담지만 규칙은 세 저장소가 동일해야 한다.
# .env* 만 쓰면 .env.example 까지 무시되므로 예외 줄이 반드시 필요하다.
.env*
!.env.example

# 개인 로컬 설정 (팀 공유 대상 아님)
.claude/settings.local.json

# IDE / 도구 산출물
.metadata/
shrimp_data/

# 루트에 임시로 떨어뜨린 참고용 이미지 (UI 레퍼런스 등)
# 앞의 / 때문에 루트만 해당한다. docs/ 아래 이미지는 그대로 추적된다 —
# 문서에 넣을 그림이라면 docs/ 로 옮기면 된다
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp

node_modules/
.DS_Store
*.log
